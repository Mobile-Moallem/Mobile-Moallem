{
  // STAGING. Pushes to main auto-deploy this to staging.mobilemoallem.com via Cloudflare Builds.
  // Production gets its own Worker, D1, R2 and Access app later (see cloudflare/SETUP.md step 9).
  "name": "mobile-moallem-staging",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-10-15",
  "workers_dev": true,
  "routes": [
    { "pattern": "staging.mobilemoallem.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "ACCESS_TEAM_DOMAIN": "https://weathered-frog-a300.cloudflareaccess.com",
    "ACCESS_AUD": "c59445e64ef30f28944e95b83bcee468dfe312a274ae40d72eb01009d427cc07"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mobile-moallem-staging",
      "database_id": "07f41135-03e3-4f36-b346-f67b73e7e830",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "mobile-moallem-staging-media"
    }
  ],
  // PRODUCTION. Deployed only from the `production` branch with `npx wrangler deploy --env production`.
  // Bindings and vars are not inherited from staging; every value below is production-only.
  // It starts on next.mobilemoallem.com for testing; mobilemoallem.com is added only at cutover.
  "env": {
    "production": {
      "name": "mobile-moallem",
      "workers_dev": false,
      "routes": [
        { "pattern": "next.mobilemoallem.com", "custom_domain": true }
      ],
      "vars": {
        "ACCESS_TEAM_DOMAIN": "https://weathered-frog-a300.cloudflareaccess.com",
        "ACCESS_AUD": "4503b8a54726b56b138885cf2ecbc388a181eb2646b95b327083f82edb08de9a"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "mobile-moallem-production",
          "database_id": "5843fc53-7c0c-4d8c-b5d9-da6e3898c3d6",
          "migrations_dir": "drizzle"
        }
      ],
      "r2_buckets": [
        {
          "binding": "BUCKET",
          "bucket_name": "mobile-moallem-media-production"
        }
      ]
    }
  }
}
