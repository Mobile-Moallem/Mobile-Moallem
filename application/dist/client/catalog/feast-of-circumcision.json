ntent":""},{"language":"English","content":"Ask the Lord on our behalf, that He may have mercy on our souls, and forgive us our sins."},{"language":"Arabic","content":""}],"isComment":false},{"columns":[{"language":"Coptic","content":""},{"language":"English","content":"O Virgin Mary, the holy Theotokos, the faithful advocate for all mankind,"},{"language":"Arabic","content":""}],"isComment":false},{"columns":[{"language":"Coptic","content":""},{"language":"English","content":"Intercede on our behalf before Christ, whom you bore, that He may grant us the forgiveness of our sins."},{"language":"Arabic","content":""}],"isComment":false},{"columns":[{"language":"Coptic","content":""},{"language":"English","content":"Hail to you, O Virgin, the right and true Queen. Hail to the pride of our race, who bore to us Immanuel."},{"language":"Arabic","content":""}],"isComment":false},{"columns":[{"language":"Coptic","content":""},{"language":"English","content":"We ask you to remember us, O our faithful advocate, before our Lord Jesus Christ, that He may forgive us our sins."},{"language":"Arabic","content":""}],"isComment":false}]}}],"2":[{"name":"Default","contentType":"Hazzat","content":{"englishHazzat":"<span class=\"EnglishFont\">Hai</span><span class=\"HazzatFont\">x </span><span class=\"EnglishFont\">l to</span><span class=\"HazzatFont\">x </span><span class=\"EnglishFont\">you</span><span class=\"HazzatFont\">zz.x x </span><span class=\"EnglishFont\">O</span><span class=\"HazzatFont\">x </span><span class=\"EnglishFont\">Vi</span><span class=\"HazzatFont\">x.x x x </span><span class=\"EnglishFont\">rgi</span><span class=\"HazzatFont\">cd.</span><br><span class=\"HazzatFont\">x </span><span class=\"EnglishFont\">n the</span><span class=\"HazzatFont\">x x x </span><span class=\"EnglishFont\">ri</span><span class=\"HazzatFont\">x x </span><span class=\"EnglishFont\">ght a</span><span class=\"HazzatFont\">cd.zz</span><span class=\"EnglishFont\">nd true</span><span class=\"H