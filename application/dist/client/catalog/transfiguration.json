[{"language":"coptic","content":""},{"language":"english","content":"Amen. Alleluia. Glory to the Father, and to the Son, and to the Holy Spirit."},{"language":"arabic","content":""}]},{"columns":[{"language":"Coptic","content":""},{"language":"English","content":"Now and ever and unto the age of the ages. Amen."},{"language":"Arabic","content":""}],"isComment":false},{"columns":[{"language":"Coptic","content":""},{"language":"English","content":"We proclaim and say, O our Lord Jesus Christ,"},{"language":"Arabic","content":""}],"isComment":false},{"columns":[{"language":"Coptic","content":""},{"language":"English","content":"On the Feast of Transfiguration"},{"language":"Arabic","content":""}],"isComment":true},{"columns":[{"language":"Coptic","content":""},{"language":"English","content":"The Son of God, was transfigured on mount Tabor. Save us and have mercy on us."},{"language":"Arabic","content":""}],"isComment":false},{"columns":[{"language":"Coptic","content":""},{"language":"English","content":"Lord have mercy. Lord have mercy. Lord bless us. Amen. Bless me. Bless me. Lo, the repentance. Forgive me. Say the blessing."},{"language":"Arabic","content":""}],"isComment":false}]}}]}}]}]